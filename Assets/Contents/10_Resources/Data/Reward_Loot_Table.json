  "rules": [
    {
      "Rule_Key": "Roll_Order",
      "Value": "GradeFirst",
      "Description": "칸마다 등급을 먼저 굴리고, 해당 칸·등급의 사용 가능한 풀(Enabled=true, 조건 통과) 안에서 균등 추첨"
    },
    {
      "Rule_Key": "Slots_Per_Screen",
      "Value": "3",
      "Description": "1번 Growth / 2번 Snack / 3번 Dice 고정, 각 칸 1개씩 표시"
    },
    {
      "Rule_Key": "Pick_Count",
      "Value": "1",
      "Description": "3개 중 1개만 선택"
    },
    {
      "Rule_Key": "Grade_Table_By_Monster",
      "Value": "Normal=standard|Elite=elite|Boss=boss",
      "Description": "처치한 몬스터 등급으로 표를 고른다"
    },
    {
      "Rule_Key": "Legendary_Pity_Screens",
      "Value": "15",
      "Description": "보스 화면을 뺀 전리품 화면 15회 연속 레전드 미등장 시, 다음 화면의 무작위 1칸을 Legendary로 확정. 레전드가 나오면 0으로. 세이브에 저장"
    },
    {
      "Rule_Key": "Fallback_If_Empty",
      "Value": "LowerGrade",
      "Description": "해당 등급 풀이 비면 한 단계 낮은 등급에서 추첨(Normal까지 비면 칸을 숨김)"
    },
    {
      "Rule_Key": "Gold_Scale",
      "Value": "TierGold",
      "Description": "Gold_Add 값에 BalanceConfig.TierGold(현재 바이옴 단계)를 곱하고 내림. 카드 설명의 {0}에 실제 값 표시"
    },
    {
      "Rule_Key": "Snack_Full_Behavior",
      "Value": "DisableCard",
      "Description": "스낵을 1개도 넣을 수 없으면 해당 카드를 비활성(어둡게 + \"스낵칸 가득\") 처리해 고를 수 없게 한다. 일부만 들어가면 들어가는 만큼 주고 토스트로 알린다"
    },
    {
      "Rule_Key": "Snack_Fill_Exclude",
      "Value": "Peppermint",
      "Description": "Snack_Random / Snack_Fill 의 무작위 스낵 풀에서 페퍼민트는 뺀다(포획 아이템은 지정 보상으로만)"
    },
    {
      "Rule_Key": "No_Duplicate_Group",
      "Value": "true",
      "Description": "같은 화면에 Group_ID가 같은 보상이 두 칸에 나오지 않는다(칸이 달라 실제로는 드묾, 안전장치)"
    },
    {
      "Rule_Key": "Tutorial",
      "Value": "LegacyPool",
      "Description": "튜토리얼 모드에서는 이 표를 쓰지 않고 기존 LootSelectionPanel 풀을 그대로 쓴다"
    }
  ],
